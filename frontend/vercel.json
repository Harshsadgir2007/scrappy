{
  "version": 2,
  "rewrites": [
    {
      "source": "/(auth|companies|materials|listings|bill|orders|inventory|trades|notifications|subscriptions|quality|admin|api|docs|openapi.json)(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
